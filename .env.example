GROQ_API_KEY=gsk_your_key_here

# Optional model overrides (Groq, OpenAI-compatible). Vision model is used for
# analysing meal photos posted in the community feed.
# ALEX_MODEL_ID=llama-3.3-70b-versatile
# ALEX_FAST_MODEL_ID=llama-3.1-8b-instant
ALEX_VISION_MODEL_ID=meta-llama/llama-4-scout-17b-16e-instruct

# Local Docker Postgres database. Start with `docker compose up -d postgres`.
DATABASE_URL=postgres://hlfitness:hlfitness@localhost:5432/hlfitness

# Keep Wrangler/Cloudflare preview output from loading .env.
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false

# Public base URL used inside login emails.
APP_BASE_URL=http://localhost:5173

# Optional SMTP email delivery for meeting confirmations and temporary login emails.
# Leave these blank for local demos that do not send email.
SMTP_HOST=

# Use port 587 with SMTP_SECURE=false for STARTTLS, or port 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Zalo Official Account (ZBS Template Message) integration for guest
# meeting confirmations, reminders and login invites. Leave blank to run in
# sandbox mode: no live messages are sent and staff get a clickable zalo.me
# deep link instead. Requires a verified OA linked to a funded ZBS Account
# and approved templates to send for real.
ZALO_OA_ID=
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
# Approved ZBS template ids per event (optional).
ZALO_TEMPLATE_CONFIRM=
ZALO_TEMPLATE_REMINDER=
ZALO_TEMPLATE_LOGIN=
